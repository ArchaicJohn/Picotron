:: main.lua
--[[pod_format="raw",created="2026-05-08 01:30:37",modified="2026-05-08 01:37:31",revision=21]]
x,y=64,64
spd=0.5
zoom=3
-- 1 far - 480x270
-- 2 mid - 240x135
-- 3 close - 120x67
-- 4 ext close - 96x?

function _init()
	vid(zoom)
end

function _update()
	if btn(0) then
		x-=spd
	elseif btn(1) then
		x+=spd
	end
	
	if btn(2) then
		y-=spd
	elseif btn(3) then
		y+=spd
	end
end

function _draw()
	cls()
	spr(1,x,y)
end
