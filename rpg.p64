--[[pod_format="raw",created="2026-05-07 01:34:43",modified="2026-05-07 01:34:43",revision=0]]
function doinput()
	butn=getinput()
	
	if butn==4 then
		--player.interact()
	end
	
end

function getinput()
	for i=0,5 do
		if btn(i) then
			return i
		end
	end
	return -1
end
:: main.lua
--[[pod_format="raw",created="2026-05-05 00:06:08",modified="2026-05-07 02:02:25",revision=74]]
include "anim.lua"
include "camera.lua"
include "entity.lua"
include "globals.lua"
include "input.lua"
include "utils.lua"

entities={}

function init()
	-- none of these add to the entities table... why?
	player=makeplayer(240,120)
	add(entities,player)
	add(entities,1)
	playanim(player,"walklr")
end

function _update()
	doinput()
	for e in all(entities) do
		e.update()
	end
	
	if btnp(5) then
		local e=makeentity(32,32,7,7,false,1,5,5,2,true)
		e.anim=newanim(1,1)
		playanim(e,"anim")
		add(entities,e)
	end
end

function _draw()
	cls()
	palt(0,false)
	palt(30,true)
	print(#entities)
	--sortbyy(entities)
	for e in all(entities) do
		e.draw()
	end
end
:: utils.lua
--[[pod_format="raw",created="2026-05-07 01:34:41",modified="2026-05-07 01:34:41",revision=0]]
--[[ general purpose utilities ]]

--get a map tile flag at pixel coordinate x,y
function fmget(x,y)
	return fget(mget(x/8, y/8))
end

--assumes flag 1 is solid
function checksolid(x,y,w,h)
	if (fget(mget(x/8,(y)/8)) == 1 or
		fget(mget((x+w)/8,y/8)) == 1 or
		fget(mget(x/8,(y+h)/8)) == 1 or
		fget(mget((x+w)/8,(y+h)/8)) == 1) then 
			return true
	end
	return false
end

--checks to see if flag 1 is set for an object that has x,y,w,h defined
function checksolidobj(a)
	return checksolid(a.x,a.y,a.w,a.h)
end

-- checks coordinate overlaps using exclusion
function overlap(ax,ay,ax1,ay1,bx,by,bx1,by1)
	if	ax>bx1 or
		ay>by1 or
		ax1<bx or
		ay1<by then
			return false
	end
	return true
end

-- check object overlaps using exclusion
function overlapobj(a,b)
	if (a.x>b.x1 or 
		a.y>b.y1 or 
		a.x1<b.x or 
		a.y1<b.y) then
			return false
	end	
	return true
end

function wait(t)
	repeat
		t-=1
		flip()
	until t<0
end

--sorts a table of objects by their y position on the screen
function sortbyy(a)
	for i=1,#a do
		local j=i
		while j>1 and a[j-1].y>a[j].y do
			a[j],a[j-1]=a[j-1],a[j]
			j=j-1
		end
	end
end

--interpolates a towards b by v
function lerp(a,b,v)
	a+=(b-a)*v
	return a
end

--the classic
function fudge(a,pct)
	pct = pct or 0.3
	a+=(rnd(1)*pct*2-pct)*a
	return a
end
