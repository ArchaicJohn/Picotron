:: entity.lua
--[[pod_format="raw",created="2026-05-07 01:34:40",modified="2026-05-07 01:39:36",revision=1]]
function makeentity(ex,ey,ew,eh,interactable,ecx,ecy,ecw,ech,ecollide)
    local e={
        x=ex,
        y=ey,
        w=ew,
        h=eh,
        x1=ex+ew,
        y1=ey+eh,
        dx=0,
        dy=0,
        spd=1,
        flip=false,
        dir=0,
        caninteract=interactable,
        --collider
        cx=ex+ecx,
        cy=ey+ecy,
        cw=ecw,
        ch=ech,
        cx1=ex+ecx+ecw,
        cy1=ey+ecy+ech,
        collide = ecollide
    }

    function e:update()
    end

    function e:draw()
        spr(updateanim(e),e.x,e.y,1,1,e.flip)
    end

    function e:drawcollider()
		rect(e.cx,e.cy,e.cx1,e.cy1,11)
	end

    function e:interact()
    end

    function e:move()
		if e.collide then
			e.movewithcollision()
		else
			e.updateobjposition()
			e.updatecolliderposition()
		end
	end

	function e:movewithcollision()
		--last good deltas
		lgdx,lgdy=0,0

		--these iterators are required for the for loops to move in the correct direction
		local dxi = 1
		if e.dx < 0 then dxi = -1 end

		local dyi = 1
		if e.dy < 0 then dyi = -1 end

		for nx=0,e.dx,dxi do
			for ny=0,e.dy,dyi do
				local ocx=e.cx+nx
				local ocy=e.cy+ny
				local ocx1=e.cx1+nx
				local ocy1=e.cy1+ny
				local posgood = true
                
                -- entity collsion
				for ent in all(entities) do
					-- exclude self
					if (ent ~= e) then
						if (overlap(ocx,ocy,ocx1,ocy1,ent.cx,ent.cy,ent.cx1,ent.cy1)) then
							posgood = false;
							break
						end
					end
				end
                
                -- tile collision
                if  fmget(ocx,ocy)==tilesolid or 
                    fmget(ocx1,ocy)==tilesolid or
                    fmget(ocx,ocy1)==tilesolid or
                    fmget(ocx1,ocy1)==tilesolid then
                    posgood=false
                end

				if posgood then
					lgdx,lgdy=nx,ny
				end
			end
		end

		-- set new, good delta for movement
		e.dx,e.dy=lgdx,lgdy
		e.updateobjposition()
		e.updatecolliderposition()
	end

    function e:updateobjposition()
        e.x+=e.dx
        e.y+=e.dy
        e.x1=e.x+e.w
        e.y1=e.y+e.h
    end

    function e:updatecolliderposition()
        e.cx+=e.dx
        e.cy+=e.dy
        e.cx1=e.cx+e.cw
        e.cy1=e.cy+e.ch
    end

    add(entities,e)

    return e
end

function makeplayer(x,y)
	local p=makeentity(x,y,7,7,false,1,5,5,2,true)

	p.walklr=newanim({3,4})
	p.walkup=newanim({6,5})
	p.walkdown=newanim({1,2})

	return p
end
