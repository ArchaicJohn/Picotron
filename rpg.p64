--[[pod_format="raw",created="2026-05-06 23:17:06",modified="2026-05-07 01:34:39",revision=9]]
--[[ animation functions ]]

local default_global_timing = 10

--[[
	PLAYING ANIMATIONS:
	playanim(obj, anim): your table, and your created animation (or the name of an animation stored in obj)

	UPDATING SPRITES:
	spr(updateanim(obj), ...)

	CREATING ANIMATIONS:

	all timing is in frames at 30fps
	all sprite indexes are absolute sprite sheet indexes
	usage:
	newanim(spritetable, defaulttiming)
		spritetable can have timing overrides as such: {4,{5,2},7}

	newanim(spriteidx, count, timing)
		for simple contiguous animations from spriteidx -> spriteidx + count-1, with timing

]]

local simple = function(state, a)
	state.time = state.time + 1

	if state.time >= a.timing then
		state.time = 0
		state.idx = state.idx + 1
		if a.sprite + state.idx > a.maxidx + 1 then
			state.idx = 1
		end
	end

	return a.sprite + state.idx - 1
end

local custom = function(state, a)
	state.time = state.time + 1

	local max = #a.sprites -- or a.maxidx + 1
	local cur = a.sprites[state.idx]
	local timing = a.timing
	if type(cur) == "table" then
		timing = cur[2]
		cur = cur[1]
	end
	local next = (state.idx + 1 <= max and a.sprites[state.idx+1]) or a.sprites[1]
	if type(next) == "table" then
		next = next[1]
	end

	if state.time >= timing then
		state.time = 0
		state.idx = state.idx + 1
		cur = next
		if state.idx > max then
			state.idx = 1
		end
	end

	return cur
end

function newanim(spritesoridx, cntortiming, defaulttiming)
	if type(spritesoridx) == "table" then
		return {play = custom, sprites = spritesoridx, timing = cntortiming or default_global_timing}
	else
		return {play = simple, sprite = spritesoridx, maxidx = spritesoridx + cntortiming - 1, timing = defaulttiming or default_global_timing}
	end
end

function playanim(target, a)
	local anim = type(a) == "string" and target[a] or a
	-- start at end index so we correctly play first frame without hax
	if not target.curanim or target.curanim.anim ~= anim then
		target.curanim = {time = anim.timing, idx = anim.maxidx or #anim.sprites, anim = anim}
	end
end

function updateanim(target)
	local d, a = target.curanim, target.curanim.anim
	if d ~= nil then
		return a.play(d, a)
	end
end
